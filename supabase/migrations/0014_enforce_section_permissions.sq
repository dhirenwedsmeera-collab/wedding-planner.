USING (public.has_section_access('notes', 'view'));

CREATE POLICY "notes: insert"
ON public.notes FOR INSERT
WITH CHECK (public.has_section_access('notes', 'edit'));

CREATE POLICY "notes: update"
ON public.notes FOR UPDATE
USING (
  (author_id = auth.uid() OR public.is_admin())
  AND public.has_section_access('notes', 'edit')
)
WITH CHECK (
  (author_id = auth.uid() OR public.is_admin())
  AND public.has_section_access('notes', 'edit')
);

CREATE POLICY "notes: delete own or admin"
ON public.notes FOR DELETE
USING (
  (author_id = auth.uid() OR public.is_admin())
  AND public.has_section_access('notes', 'edit')
);

-- Decision policy names need verification against pg_policies.
DROP POLICY IF EXISTS "key_decisions: read all" ON public.key_decisions;
DROP POLICY IF EXISTS "key_decisions: admin insert" ON public.key_decisions;
DROP POLICY IF EXISTS "key_decisions: admin update" ON public.key_decisions;
