CREATE POLICY "booking_events: admin delete"
ON public.booking_events FOR DELETE
USING (public.has_section_access('bookings', 'edit'));

-- Booking lead times
DROP POLICY IF EXISTS "booking lead times: signed-in read" ON public.booking_lead_times;
DROP POLICY IF EXISTS "booking lead times: admin insert" ON public.booking_lead_times;
DROP POLICY IF EXISTS "booking lead times: admin update" ON public.booking_lead_times;
DROP POLICY IF EXISTS "booking lead times: admin delete" ON public.booking_lead_times;

CREATE POLICY "booking lead times: signed-in read"
ON public.booking_lead_times FOR SELECT
USING (public.has_section_access('bookings', 'view'));

CREATE POLICY "booking lead times: admin insert"
ON public.booking_lead_times FOR INSERT
WITH CHECK (public.has_section_access('bookings', 'edit'));

CREATE POLICY "booking lead times: admin update"
ON public.booking_lead_times FOR UPDATE
USING (public.has_section_access('bookings', 'edit'))
WITH CHECK (public.has_section_access('bookings', 'edit'));

CREATE POLICY "booking lead times: admin delete"
ON public.booking_lead_times FOR DELETE
USING (public.has_section_access('bookings', 'edit'));

