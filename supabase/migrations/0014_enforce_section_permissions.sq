WITH CHECK (public.has_section_access('decisions', 'edit'));

CREATE POLICY "key_decisions: admin delete"
ON public.key_decisions FOR DELETE
USING (public.has_section_access('decisions', 'edit'));

-- ---------------------------------------------------------
-- FILE METADATA
-- Storage object policies are separate and not changed here.
-- ---------------------------------------------------------

DROP POLICY IF EXISTS "files: read all" ON public.event_files;
DROP POLICY IF EXISTS "files: insert" ON public.event_files;
DROP POLICY IF EXISTS "files: delete own or admin" ON public.event_files;
DROP POLICY IF EXISTS "files: update own or admin" ON public.event_files;

CREATE POLICY "files: read all"
ON public.event_files FOR SELECT
USING (public.has_section_access('files', 'view'));

CREATE POLICY "files: insert"
ON public.event_files FOR INSERT
WITH CHECK (public.has_section_access('files', 'edit'));

CREATE POLICY "files: update own or admin"
ON public.event_files FOR UPDATE
USING (
  (uploaded_by = auth.uid() OR public.is_admin())
  AND public.has_section_access('files', 'edit')
)
WITH CHECK (
  (uploaded_by = auth.uid() OR public.is_admin())
  AND public.has_section_access('files', 'edit')
);

CREATE POLICY "files: delete own or admin"
ON public.event_files FOR DELETE
USING (
  (uploaded_by = auth.uid() OR public.is_admin())
  AND public.has_section_access('files', 'edit')
);

COMMIT;
