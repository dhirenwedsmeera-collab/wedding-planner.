DROP POLICY IF EXISTS "section_items: insert signed in" ON public.event_section_items;
DROP POLICY IF EXISTS "section_items: update" ON public.event_section_items;
DROP POLICY IF EXISTS "section_items: delete" ON public.event_section_items;

CREATE POLICY "section_items: read all"
