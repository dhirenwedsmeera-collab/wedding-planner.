DROP POLICY IF EXISTS "checklist: read all" ON public.task_checklist_items;
DROP POLICY IF EXISTS "checklist: write" ON public.task_checklist_items;
DROP POLICY IF EXISTS "checklist: update" ON public.task_checklist_items;
DROP POLICY IF EXISTS "checklist: delete" ON public.task_checklist_items;

