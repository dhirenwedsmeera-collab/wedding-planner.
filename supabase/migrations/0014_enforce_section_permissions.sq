ON public.task_checklist_items FOR SELECT
USING (public.has_section_access('tasks', 'view'));

CREATE POLICY "checklist: write"
ON public.task_checklist_items FOR INSERT
WITH CHECK (public.has_section_access('tasks', 'edit'));

CREATE POLICY "checklist: update"
ON public.task_checklist_items FOR UPDATE
USING (public.has_section_access('tasks', 'edit'))
WITH CHECK (public.has_section_access('tasks', 'edit'));

CREATE POLICY "checklist: delete"
ON public.task_checklist_items FOR DELETE
USING (public.has_section_access('tasks', 'edit'));

-- Task comments
DROP POLICY IF EXISTS "comments: read all" ON public.task_comments;
DROP POLICY IF EXISTS "comments: insert own" ON public.task_comments;
DROP POLICY IF EXISTS "comments: delete own or admin" ON public.task_comments;
DROP POLICY IF EXISTS "comments: update own or admin" ON public.task_comments;

CREATE POLICY "comments: read all"
ON public.task_comments FOR SELECT
USING (public.has_section_access('tasks', 'view'));

CREATE POLICY "comments: insert own"
ON public.task_comments FOR INSERT
WITH CHECK (
  auth.uid() = author_id
  AND public.has_section_access('tasks', 'edit')
);

CREATE POLICY "comments: update own or admin"
ON public.task_comments FOR UPDATE
USING (
  (auth.uid() = author_id OR public.is_admin())
  AND public.has_section_access('tasks', 'edit')
)
WITH CHECK (
  (auth.uid() = author_id OR public.is_admin())
  AND public.has_section_access('tasks', 'edit')
);

CREATE POLICY "comments: delete own or admin"
ON public.task_comments FOR DELETE
USING (
  (auth.uid() = author_id OR public.is_admin())
  AND public.has_section_access('tasks', 'edit')
);

-- ---------------------------------------------------------
-- NOTES AND DECISIONS
-- ---------------------------------------------------------

DROP POLICY IF EXISTS "notes: read all" ON public.notes;
DROP POLICY IF EXISTS "notes: insert" ON public.notes;
DROP POLICY IF EXISTS "notes: update" ON public.notes;
DROP POLICY IF EXISTS "notes: delete own or admin" ON public.notes;

