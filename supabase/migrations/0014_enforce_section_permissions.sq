DROP POLICY IF EXISTS "event_sections: read all" ON public.event_sections;
DROP POLICY IF EXISTS "event_sections: admin insert" ON public.event_sections;
DROP POLICY IF EXISTS "event_sections: admin update" ON public.event_sections;
