-- ---------------------------------------------------------

DROP POLICY IF EXISTS "shopping: read all" ON public.shopping_items;
DROP POLICY IF EXISTS "shopping: admin insert" ON public.shopping_items;
DROP POLICY IF EXISTS "shopping: update" ON public.shopping_items;
