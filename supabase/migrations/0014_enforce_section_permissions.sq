
-- 0014_enforce_section_permissions.sql
-- Enforce section-level access for family and volunteers.
-- Admins retain full access through has_section_access().
-- Review on the feature branch before running against any database.

BEGIN;

-- ---------------------------------------------------------
-- BOOKINGS
-- ---------------------------------------------------------

DROP POLICY IF EXISTS "bookings: read all" ON public.bookings;
DROP POLICY IF EXISTS "bookings: admin insert" ON public.bookings;
DROP POLICY IF EXISTS "bookings: admin write" ON public.bookings;
DROP POLICY IF EXISTS "bookings: admin update" ON public.bookings;
DROP POLICY IF EXISTS "bookings: admin delete" ON public.bookings;

CREATE POLICY "bookings: read all"
ON public.bookings FOR SELECT
USING (public.has_section_access('bookings', 'view'));

CREATE POLICY "bookings: admin insert"
ON public.bookings FOR INSERT
WITH CHECK (public.has_section_access('bookings', 'edit'));

CREATE POLICY "bookings: admin update"
ON public.bookings FOR UPDATE
USING (public.has_section_access('bookings', 'edit'))
WITH CHECK (public.has_section_access('bookings', 'edit'));

CREATE POLICY "bookings: admin delete"
ON public.bookings FOR DELETE
USING (public.has_section_access('bookings', 'edit'));

-- Booking-event links
DROP POLICY IF EXISTS "booking_events: read signed in" ON public.booking_events;
DROP POLICY IF EXISTS "booking_events: admin insert" ON public.booking_events;
DROP POLICY IF EXISTS "booking_events: admin delete" ON public.booking_events;

CREATE POLICY "booking_events: read signed in"
ON public.booking_events FOR SELECT
